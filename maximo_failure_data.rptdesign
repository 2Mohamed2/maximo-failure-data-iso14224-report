                    <property name="dataType">float</property></structure>
                <structure><property name="name">n_cause</property>
                    <expression name="expression" type="javascript">dataSetRow["n_cause"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">n_rem</property>
