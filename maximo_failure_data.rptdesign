            <method name="open"><![CDATA[rows_dsPeriod = 0; periodDone = false;
dsPeriodDS = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
dsPeriodDS.open();
dbEngine = dbKind(dsPeriodDS);
dsPeriodDS.setQuery(mxPeriodSql(dbEngine, pv("Site"), "mxfail"));]]></method>
            <method name="fetch"><![CDATA[if (periodDone) return (false);
periodDone = true;
var counts = {}, upg = null;
try {
  while (dsPeriodDS.fetch()) {
    counts[dsPeriodDS.getInteger("yr") * 12 + dsPeriodDS.getInteger("mo") - 1] = dsPeriodDS.getInteger("n");
    upg = dsPeriodDS.getString("upg");
  }
} catch (e) {
  rptErrs["dsPeriod"] = String(e);
  scriptLogger.error(RPT_NAME + ": dsPeriod failed: " + e);
}
P = rptPeriod(counts);
row["period"] = P.label; row["months"] = P.months; row["auto"] = P.auto ? 1 : 0; row["upg"] = upg;
rows_dsPeriod++;
return (true);]]></method>
            <method name="close"><![CDATA[dsPeriodDS.close();]]></method>
        </script-data-set>
