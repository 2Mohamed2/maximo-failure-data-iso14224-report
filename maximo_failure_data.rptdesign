<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">Eclipse BIRT Designer Version 4.3.1.v201309091055 Build &lt;4.3.1.v20130918-1142></property>
    <property name="author">Mohamed Chihaoui</property>
    <html-property name="description">Failure data completeness against ISO 14224, failure Paretos and reliability by equipment class, for SQL Server, Oracle and Db2 (read-only). Created by Mohamed Chihaoui.</html-property>
    <property name="units">in</property>
    <method name="initialize"><![CDATA[importPackage(Packages.com.ibm.tivoli.maximo.report.script);
mxReportScriptContext = MXReportScriptContext.initialize(reportContext);
scriptLogger = mxReportScriptContext.getReportScriptLogger();
// Shared SQL helpers for the Maximo BIRT report packs: one dialect per database (Microsoft SQL Server, Oracle, IBM Db2).
// Built into each report by its build.py; Maximo only needs the .rptdesign.
// Created by Mohamed Chihaoui.
function mxCodes(csv, dflt) {
  var out = [], raw = String(csv == null || csv === "" ? dflt : csv).split(",");
  for (var i = 0; i < raw.length; i++) {
    var v = raw[i].replace(/^\s+|\s+$/g, "").toUpperCase();
    if (v.length > 0 && /^[A-Z0-9_\-]+$/.test(v)) out.push("'" + v + "'");
  }
  return out.length ? out.join(",") : "'~'";
}

function mxSite(site) {
  var s = String(site == null ? "" : site).replace(/^\s+|\s+$/g, "").toUpperCase();
  return /^[A-Z0-9_\-]+$/.test(s) ? s : "";
}

// work orders reported per month (the report picks its period from it) and the Maximo version
function mxPeriodSql(db, site, tag) {
  var ORA = db == "oracle", s = mxSite(site);
  var y = ORA ? "extract(year from w.reportdate)" : "year(w.reportdate)";
  var m = ORA ? "extract(month from w.reportdate)" : "month(w.reportdate)";
  return "select /* " + tag + " */ " + y + " yr, " + m + " mo, count(*) n, v.upg upg from workorder w " +
         "cross join (select max(varvalue) upg from maxvars where varname = 'MAXUPG') v " +
         "where w.woclass = 'WORKORDER' and w.istask = 0 and w.reportdate is not null" +
         (s ? " and w.siteid = '" + s + "'" : "") + " group by " + y + ", " + m + ", v.upg";
}

function mxDialect(db, site, tag) {
  var SS = db == "sqlserver", ORA = db == "oracle", DB2 = !SS && !ORA;
  var x = { SS: SS, ORA: ORA, DB2: DB2, site: mxSite(site) };
  x.DUAL = ORA ? " from dual" : DB2 ? " from sysibm.sysdummy1" : "";
  x.d = function (s) {   // date literal YYYY-MM-DD
    if (SS) return "cast('" + s + "' as datetime)";
    if (ORA) return "to_date('" + s + "', 'YYYY-MM-DD')";
    return "timestamp('" + s + " 00:00:00')";
  };
  x.hrs = function (a, b) {   // hours from a to b
    if (SS) return "(datediff(minute, " + a + ", " + b + ") / 60.0)";
    if (ORA) return "((" + b + " - " + a + ") * 24)";
    return "(((days(" + b + ") - days(" + a + ")) * 86400 + (midnight_seconds(" + b + ") - midnight_seconds(" + a + "))) / 3600.0)";
  };
  x.dys = function (a, b) { return "(" + x.hrs(a, b) + " / 24.0)"; };
  x.ym = function (c) { return SS ? "convert(char(7), " + c + ", 120)" : ORA ? "to_char(" + c + ", 'YYYY-MM')" : "varchar_format(" + c + ", 'YYYY-MM')"; };
  x.str = function (c) { return SS ? "cast(" + c + " as varchar(60))" : ORA ? "to_char(" + c + ")" : "trim(cast(" + c + " as char(60)))"; };
  x.limit = function (sql, n) {
    if (SS) return "select top " + n + " " + sql.substring(7);
    if (ORA) return "select * from (" + sql + ") where rownum <= " + n;
    return sql + " fetch first " + n + " rows only";
  };
  x.mark = function (sql) { return sql.replace(/^select /, "select /* " + tag + " */ "); };
  x.siteF = function (a) { return x.site ? " and " + a + ".siteid = '" + x.site + "'" : ""; };
  x.nz = function (c) { return "coalesce(" + c + ", 0)"; };
  x.sumIf = function (cond, expr) { return "sum(case when " + cond + " then " + expr + " else 0 end)"; };
  x.cntIf = function (cond) { return x.sumIf(cond, "1"); };
  // work order with its status synonym (renamed statuses count correctly)
  x.wo = function (w, st) {
    return "workorder " + w + " join synonymdomain " + st + " on " + st + ".domainid = 'WOSTATUS' and " + st + ".value = " + w + ".status";
  };
  x.cost = function (w) {
    return "(" + x.nz(w + ".actlabcost") + " + " + x.nz(w + ".actmatcost") + " + " + x.nz(w + ".actservcost") + " + " + x.nz(w + ".acttoolcost") + ")";
  };
  x.operating = function (a, sa) {
    return "asset " + a + " join synonymdomain " + sa + " on " + sa + ".domainid = 'LOCASSETSTATUS' and " + sa + ".value = " + a + ".status";
  };
  return x;
}

if (typeof module !== "undefined") module.exports = { mxCodes: mxCodes, mxSite: mxSite, mxPeriodSql: mxPeriodSql, mxDialect: mxDialect };

// Maximo failure data and reliability report (ISO 14224): read-only SQL for SQL Server, Oracle and Db2.
//
//   fdSql(db, p) -> { key: sql }
//     p : { site, start, end, corr, emer }   start / end "YYYY-MM-DD", end exclusive
//
// A failure is a corrective or emergency work order (not generated by a PM) completed in the period. For each one the
// report checks the data ISO 14224 asks for: the equipment (asset and its class), the failure mode (Maximo problem code),
// the failure cause or mechanism (cause code), the maintenance activity (remedy code), repair time and downtime.
// Every statement is a SELECT on Maximo tables. Uses mxDialect from _common/mxsql.js. Created by Mohamed Chihaoui.
function fdSql(db, p) {
  var x = mxDialect(db, p.site, "mxfail");
  var S = x.d(p.start), E = x.d(p.end);
  var FAIL = mxCodes(p.corr, "CM,CMCAL") + "," + mxCodes(p.emer, "EM,EMCAL");
  // failure report lines per work order: has a problem, a cause, a remedy
  var FR = "select f.wonum, f.siteid, max(case when f.type = 'PROBLEM' then f.failurecode end) prob, " +
           "max(case when f.type = 'CAUSE' then f.failurecode end) cause, max(case when f.type = 'REMEDY' then f.failurecode end) rem " +
           "from failurereport f group by f.wonum, f.siteid";
  // downtime reported against the work order (asset status changes)
  var DT = "select x.wonum, x.siteid, sum(" + x.nz("x.downtime") + ") down_hrs from assetstatus x where x.wonum is not null and x.isrunning = 1 " +
           "group by x.wonum, x.siteid";
  var REPAIR = "(w.actstart is not null and w.actfinish > w.actstart and " + x.hrs("w.actstart", "w.actfinish") + " <= 720)";
  var X = "select w.wonum, w.siteid site, w.assetnum asset, w.location loc, w.failurecode fclass, r.prob, r.cause, r.rem, " +
          "w.actfinish fin, " + x.cost("w") + " cost, case when " + REPAIR + " then " + x.hrs("w.actstart", "w.actfinish") + " end rep_hrs, " +
          "d.down_hrs, a.classstructureid cls, " + x.ym("w.actfinish") + " bkt, case when cf.failurecode is null then 0 else 1 end incat " +
          "from " + x.wo("w", "st") + " left join (" + FR + ") r on r.wonum = w.wonum and r.siteid = w.siteid " +
          "left join (" + DT + ") d on d.wonum = w.wonum and d.siteid = w.siteid " +
          "left join asset a on a.assetnum = w.assetnum and a.siteid = w.siteid " +
          "left join (select distinct fl.failurecode from failurelist fl where fl.parent is null) cf on cf.failurecode = w.failurecode " +
          "where w.woclass = 'WORKORDER' and w.istask = 0 and w.pmnum is null and upper(w.worktype) in (" + FAIL + ") " +
          "and st.maxvalue in ('COMP','CLOSE') and w.actfinish >= " + S + " and w.actfinish < " + E + x.siteF("w");
  var FULL = "(z.asset is not null and z.fclass is not null and z.prob is not null and z.cause is not null and z.rem is not null)";
  function completeness(groupCol) {
    return "count(*) n, " + x.cntIf("z.asset is not null") + " n_asset, " + x.cntIf("z.cls is not null") + " n_cls, " +
      x.cntIf("z.fclass is not null") + " n_fclass, " + x.cntIf("z.prob is not null") + " n_prob, " + x.cntIf("z.cause is not null") + " n_cause, " +
      x.cntIf("z.rem is not null") + " n_rem, " + x.cntIf("z.rep_hrs is not null") + " n_rep, " + x.cntIf("z.down_hrs is not null") + " n_down, " +
      x.cntIf(FULL) + " n_full, " + x.cntIf("z.fclass is not null and z.incat = 0") + " n_notcat";
  }
  var o = {};
  var CAT = "select (select count(*) from failurelist fl where fl.parent is null) cat_class, " +
            "(select count(*) from failurelist fl where fl.type = 'PROBLEM') cat_prob, " +
            "(select count(*) from failurelist fl where fl.type = 'CAUSE') cat_cause, " +
            "(select count(*) from failurelist fl where fl.type = 'REMEDY') cat_rem" + x.DUAL;
  o.kpiSql = x.mark("select * from (select " + completeness() + ", count(distinct z.asset) assets, sum(z.cost) cost, " +
    x.sumIf("z.rep_hrs is not null", "z.rep_hrs") + " rep_hrs, " + x.sumIf("z.down_hrs is not null", "z.down_hrs") + " down_hrs from (" + X + ") z) q1 " +
    "cross join (" + CAT + ") q2");
  o.siteSql = x.mark("select z.site, " + completeness() + ", sum(z.cost) cost from (" + X + ") z group by z.site order by 2 desc");
  // failure classes typed on work orders that the Failure Codes application does not define
  o.unknownSql = x.mark(x.limit("select z.fclass code, count(*) n, count(distinct z.asset) assets, sum(z.cost) cost from (" + X + ") z " +
    "where z.fclass is not null and z.incat = 0 group by z.fclass order by 2 desc", 15));
  o.monthlySql = x.mark("select z.bkt, " + x.cntIf(FULL) + " n_full, count(*) - " + x.cntIf(FULL) + " n_part, " +
    x.cntIf("z.fclass is null") + " n_none from (" + X + ") z group by z.bkt order by 1");

  // Paretos: failure classes, failure modes (problems), causes, remedies
  function pareto(col, n) {
    var C = "coalesce(z." + col + ", '(not recorded)')";
    return x.mark(x.limit("select " + C + " code, max(fc.description) descr, count(*) n, count(distinct z.asset) assets, sum(z.cost) cost, " +
      x.sumIf("z.rep_hrs is not null", "z.rep_hrs") + " rep_hrs, " + x.cntIf("z.rep_hrs is not null") + " rep_n " +
      "from (" + X + ") z left join failurecode fc on fc.failurecode = z." + col + " group by " + C + " order by 3 desc", n));
  }
  o.classSql = pareto("fclass", 10);
  o.probSql = pareto("prob", 12);
  o.causeSql = pareto("cause", 12);
  o.remSql = pareto("rem", 10);

  // reliability by equipment class (classification): MTBF over the operating assets of the class
  var CL = "coalesce(cs.classificationid, '(no classification)')";
  var OPS = "select coalesce(a.classstructureid, '~') cls, count(*) n_ops from " + x.operating("a", "sa") +
            " where sa.maxvalue = 'OPERATING'" + x.siteF("a") + " group by coalesce(a.classstructureid, '~')";
  o.equipSql = x.mark(x.limit("select " + CL + " cls, max(o.n_ops) n_ops, count(*) fails, count(distinct z.asset) failed, " +
    x.sumIf("z.rep_hrs is not null", "z.rep_hrs") + " rep_hrs, " + x.cntIf("z.rep_hrs is not null") + " rep_n, sum(z.cost) cost, " +
    x.cntIf(FULL) + " n_full from (" + X + ") z left join classstructure cs on cs.classstructureid = z.cls " +
    "left join (" + OPS + ") o on o.cls = coalesce(z.cls, '~') where z.asset is not null group by " + CL + " order by 3 desc", 15));

  // the failure code catalogue: classes with how many problems, causes and remedies, and how much they are used
  o.catalogSql = x.mark(x.limit("select fc.failurecode code, max(fc.description) descr, " +
    "(select count(*) from failurelist p where p.parent = fl.failurelist and p.type = 'PROBLEM') probs, " +
    "(select count(*) from failurelist p join failurelist c on c.parent = p.failurelist where p.parent = fl.failurelist and c.type = 'CAUSE') causes, " +
    "(select count(*) from " + x.wo("w", "st") + " where w.failurecode = fc.failurecode and w.istask = 0 and w.woclass = 'WORKORDER' " +
    "and st.maxvalue in ('COMP','CLOSE') and w.actfinish >= " + S + " and w.actfinish < " + E + x.siteF("w") + ") used " +
    "from failurecode fc join failurelist fl on fl.failurecode = fc.failurecode and fl.parent is null " +
    "group by fc.failurecode, fl.failurelist order by 5 desc, 1", 25));
  if (x.SS) for (var k in o) if (k != "catalogSql" && k != "kpiSql") o[k] = o[k] + " option (hash join)";
  return o;
}

if (typeof module !== "undefined") module.exports = { fdSql: fdSql };


dbEngine = null;
rptErrs = {};
P = null;
K = {};

function dbKind(ds) {
  var n = String(ds.getDatabaseProductName()).toLowerCase();
  if (n.indexOf("oracle") >= 0) return "oracle";
  if (n.indexOf("microsoft") >= 0 || n.indexOf("sql server") >= 0) return "sqlserver";
  return "db2";
}
function engineName() {
  return dbEngine == "oracle" ? "Oracle" : dbEngine == "db2" ? "Db2" : dbEngine == "sqlserver" ? "SQL Server" : "";
}
function maxVersion(v) {
  var m = /^V(\d)(\d)(\d)(\d)?-(\d+)/.exec(String(v));
  if (!m) return v == null ? "version unknown" : String(v);
  return m[1] + "." + m[2] + "." + m[3] + (m[4] ? "." + m[4] : "");
}
function pv(name) {
  try { var v = params[name].value; return v == null ? "" : String(v); } catch (e) { return ""; }
}
function siteName() { var s = mxSite(pv("Site")); return s ? "site " + s : "all sites"; }
function rptEmpty(ds, txt) { return rptErrs[ds] ? "Could not be read: " + rptErrs[ds] : txt; }

// the period: month index = year * 12 + month - 1. Default: the last complete months; a copy with no recent work
// moves back to the last month with regular activity (at least 10% of the busiest month).
function rptPeriod(counts) {
  var MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  var months = parseInt(pv("Months"), 10);
  if (isNaN(months) || months < 1) months = 12;
  if (months > 60) months = 60;
  var now = new Date(), last = now.getFullYear() * 12 + now.getMonth() - 1, end = last, auto = false;
  var em = /^(\d{4})-(\d{1,2})$/.exec(pv("End_Month").replace(/\s/g, ""));
  if (em) {
    end = parseInt(em[1], 10) * 12 + parseInt(em[2], 10) - 1;
  } else {
    var max = 0, k;
    for (k in counts) if (counts[k] > max) max = counts[k];
    if (max > 0) {
      var recent = 0;
      for (k in counts) if (Number(k) > last - 12 && Number(k) <= last) recent += counts[k];
      if (recent < max) {
        var best = -1;
        for (k in counts) if (Number(k) <= last && counts[k] >= max * 0.1 && Number(k) > best) best = Number(k);
        if (best >= 0) { end = best; auto = true; }
      }
    }
  }
  function ymd(i) { var y = Math.floor(i / 12), m = i % 12 + 1; return y + "-" + (m < 10 ? "0" : "") + m + "-01"; }
  function nice(i) { return MON[i % 12] + " " + Math.floor(i / 12); }
  var s = end - months + 1;
  var d0 = new Date(Math.floor(s / 12), s % 12, 1), d1 = new Date(Math.floor((end + 1) / 12), (end + 1) % 12, 1);
  return { start: ymd(s), end: ymd(end + 1), e365: ymd(end + 1 - 12), months: months, auto: auto,
           days: Math.round((d1.getTime() - d0.getTime()) / 86400000),
           label: months + " months: " + nice(s) + " to " + nice(end) };
}
function rptP() { if (P == null) P = rptPeriod({}); return P; }

function num(x) { return x == null || isNaN(x) ? null : Number(x); }
function ratio(a, b) { a = num(a); b = num(b); return a == null || b == null || b == 0 ? null : a / b; }
function pctText(a, b) { var r = ratio(a, b); return r == null ? "" : Formatter.format(r * 100, "#,##0.0") + "%"; }
function fmtN(v) { return v == null ? "" : Formatter.format(v, "#,##0"); }
function fmtMoney(v) {
  if (v == null) return "";
  if (Math.abs(v) >= 1e9) return Formatter.format(v / 1e9, "#,##0.0") + " bn";
  if (Math.abs(v) >= 1e6) return Formatter.format(v / 1e6, "#,##0.0") + " M";
  return Formatter.format(v, "#,##0");
}
function day10(d) { return d == null ? "" : String(d).substring(0, 10); }


RPT_NAME = "Failure data";
KCOLS = ["n", "n_asset", "n_cls", "n_fclass", "n_prob", "n_cause", "n_rem", "n_rep", "n_down", "n_full", "n_notcat", "assets", "cost", "rep_hrs", "down_hrs", "cat_class", "cat_prob", "cat_cause", "cat_rem"];
function fdP() {
  var p = rptP();
  return { site: pv("Site"), start: p.start, end: p.end, corr: pv("Corrective_Types"), emer: pv("Emergency_Types") };
}
function fdLevel(a, n) { var r = ratio(a, n); return r == null ? "" : r >= 0.9 ? "Good" : r >= 0.5 ? "Gaps" : "Poor"; }
function catHint(p, c, u) {
  p = Number(p); c = Number(c); u = Number(u);
  if (p == 0) return "No failure modes: failures can only be coded at class level.";
  if (c == 0) return "No causes under its failure modes.";
  if (u == 0) return "Not used in the period.";
  return "";
}
]]></method>
    <method name="afterFactory"><![CDATA[MXReportScriptContext.close();]]></method>
    <text-property name="displayName">Maximo Failure Data and Reliability (ISO 14224)</text-property>
    <property name="layoutPreference">auto layout</property>
    <list-property name="libraries">
        <structure>
            <property name="fileName">MaximoSystemLibrary.rptlibrary</property>
            <property name="namespace">MaximoSystemLibrary</property>
        </structure>
    </list-property>
    <parameters>
        <scalar-parameter name="Site" id="101"><text-property name="promptText">Site</text-property><text-property name="helpText">One site, or blank for all sites.</text-property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant"></value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="Months" id="102"><text-property name="promptText">Months</text-property><text-property name="helpText">Length of the period in months (1 to 60).</text-property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">12</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="End_Month" id="103"><text-property name="promptText">Last month (YYYY-MM)</text-property><text-property name="helpText">Last month of the period. Blank: the last complete month.</text-property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant"></value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="Corrective_Types" id="104"><text-property name="promptText">Corrective work types</text-property><text-property name="helpText">Work types counted as failures (planned repairs).</text-property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">CM,CMCAL</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="Emergency_Types" id="105"><text-property name="promptText">Emergency work types</text-property><text-property name="helpText">Work types counted as failures (breakdowns).</text-property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">EM,EMCAL</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="where" id="106">
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">1=1</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="appname" id="107">
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="paramdelimiter" id="108"><property name="hidden">true</property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="paramstring" id="109"><property name="hidden">true</property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
        <scalar-parameter name="usepagebreaks" id="110"><property name="hidden">true</property>
            <property name="valueType">static</property>
            <property name="isRequired">false</property>
            <property name="dataType">string</property><simple-property-list name="defaultValue"><value type="constant">true</value></simple-property-list>
            <property name="paramType">simple</property>
            <property name="controlType">text-box</property>
            <structure name="format"><property name="category">Unformatted</property></structure>
        </scalar-parameter>
    </parameters>
    <data-sources>
        <script-data-source name="maximoDataSource" id="797" extends="MaximoSystemLibrary.maximoDataSource"/>
    </data-sources>
    <data-sets>
        <script-data-set name="dsPeriod" id="764">
            <list-property name="resultSetHints">
