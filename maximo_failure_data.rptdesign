                    <property name="dataType">float</property></structure>
                <structure><property name="name">n_rep</property>
                    <expression name="expression" type="javascript">dataSetRow["n_rep"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">n_down</property>
                    <expression name="expression" type="javascript">dataSetRow["n_down"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">n_full</property>
                    <expression name="expression" type="javascript">dataSetRow["n_full"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">n_notcat</property>
                    <expression name="expression" type="javascript">dataSetRow["n_notcat"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">assets</property>
                    <expression name="expression" type="javascript">dataSetRow["assets"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">cost</property>
                    <expression name="expression" type="javascript">dataSetRow["cost"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">rep_hrs</property>
                    <expression name="expression" type="javascript">dataSetRow["rep_hrs"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">down_hrs</property>
                    <expression name="expression" type="javascript">dataSetRow["down_hrs"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">cat_class</property>
                    <expression name="expression" type="javascript">dataSetRow["cat_class"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">cat_prob</property>
                    <expression name="expression" type="javascript">dataSetRow["cat_prob"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">cat_cause</property>
                    <expression name="expression" type="javascript">dataSetRow["cat_cause"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">cat_rem</property>
                    <expression name="expression" type="javascript">dataSetRow["cat_rem"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">t0</property>
                    <expression name="expression" type="javascript"><![CDATA[fmtN(K.n)]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">t0s</property>
                    <expression name="expression" type="javascript"><![CDATA["failures on " + fmtN(K.assets) + " assets"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">t1</property>
                    <expression name="expression" type="javascript"><![CDATA[pctText(K.n_full, K.n)]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">t1s</property>
                    <expression name="expression" type="javascript"><![CDATA[fmtN(K.n_full) + " with asset, class, mode, cause and activity"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">t2</property>
                    <expression name="expression" type="javascript"><![CDATA[pctText(K.n_fclass, K.n)]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">t2s</property>
                    <expression name="expression" type="javascript"><![CDATA[fmtN(K.n_fclass) + " of " + fmtN(K.n) + " failures"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">t3</property>
                    <expression name="expression" type="javascript"><![CDATA[pctText(K.n_prob, K.n)]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">t3s</property>
                    <expression name="expression" type="javascript"><![CDATA[fmtN(K.n_prob) + " of " + fmtN(K.n) + " failures"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">t4</property>
                    <expression name="expression" type="javascript"><![CDATA[pctText(K.n_cause, K.n)]]></expression>
