    <body>
        <grid id="111">
            <property name="width">10.1in</property>
            <column id="112"><property name="width">6.8in</property></column>
            <column id="113"><property name="width">3.3in</property></column>
            <row id="114">
                <cell id="115"><property name="paddingBottom">6pt</property>
                    <label id="116"><property name="fontSize">7.5pt</property><property name="color">#525252</property><property name="fontWeight">bold</property><property name="letterSpacing">0.32pt</property><text-property name="text">IBM MAXIMO  ·  RELIABILITY  ·  ISO 14224</text-property></label>
                    <label id="117"><property name="fontSize">20pt</property><property name="color">#161616</property><property name="marginTop">2pt</property><text-property name="text">Is your failure data good enough for reliability?</text-property></label>
                    <label id="118"><property name="fontSize">9pt</property><property name="color">#525252</property><property name="marginTop">2pt</property><text-property name="text">Every failure work order checked against the data ISO 14224 asks for (equipment, class, failure mode, cause, maintenance activity, repair time, downtime), then what fails and why, and reliability by equipment class. Read-only, on SQL Server, Oracle or Db2.</text-property></label>
                    <label id="119"><property name="fontSize">8pt</property><property name="color">#0043ce</property><property name="fontWeight">bold</property><property name="marginTop">4pt</property><text-property name="text">Created by Mohamed Chihaoui</text-property></label>
                </cell>
                <cell id="120"><property name="textAlign">right</property><property name="verticalAlign">bottom</property><property name="paddingBottom">6pt</property>
                    <data id="121"><property name="fontSize">7.5pt</property><property name="color">#525252</property><property name="textAlign">right</property><list-property name="boundDataColumns"><structure><property name="name">v</property><expression name="expression" type="javascript"><![CDATA["Run " + Formatter.format(new Date(), "yyyy-MM-dd HH:mm")]]></expression><property name="dataType">string</property></structure></list-property><property name="resultSetColumn">v</property></data>
                </cell>
            </row>
        </grid>
        <table id="122">
            <property name="marginTop">6pt</property>
            <property name="width">10.1in</property>
            <property name="dataSet">dsPeriod</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">period</property>
                    <expression name="expression" type="javascript">dataSetRow["period"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">months</property>
                    <expression name="expression" type="javascript">dataSetRow["months"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">auto</property>
                    <expression name="expression" type="javascript">dataSetRow["auto"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">upg</property>
                    <expression name="expression" type="javascript">dataSetRow["upg"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">line</property>
                    <expression name="expression" type="javascript"><![CDATA[row["period"] + "  ·  " + siteName() + "  ·  Maximo " + maxVersion(row["upg"]) + "  ·  " + engineName()]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">why</property>
                    <expression name="expression" type="javascript"><![CDATA[(row["auto"] == 1 ? "The period ends at the last month with regular work order activity in this database. " : "") + "A failure is a corrective or emergency work order (not from a PM) completed in the period."]]></expression>
                    <property name="dataType">string</property></structure>
            </list-property>
            <column id="123"><property name="width">10.1in</property></column>
            <detail><row id="124"><cell id="125"><property name="backgroundColor">#edf5ff</property><property name="borderLeftColor">#0043ce</property><property name="borderLeftStyle">solid</property><property name="borderLeftWidth">3px</property><property name="paddingTop">6pt</property><property name="paddingBottom">6pt</property><property name="paddingLeft">10pt</property><property name="paddingRight">10pt</property><data id="126"><property name="fontSize">8.5pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><property name="resultSetColumn">line</property></data><data id="127"><property name="fontSize">7.5pt</property><property name="color">#525252</property><property name="marginTop">1pt</property><property name="resultSetColumn">why</property></data></cell></row></detail>
        </table>
        <table id="163">
            <property name="marginTop">10pt</property>
            <property name="width">10.10in</property>
            <property name="dataSet">dsKpi</property>
            <list-property name="boundDataColumns">
