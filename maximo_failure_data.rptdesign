            <page-footer>
                <grid id="776">
                    <property name="width">10.1in</property>
                    <column id="777"><property name="width">8.6in</property></column>
                    <column id="778"><property name="width">1.5in</property></column>
                    <row id="779">
                        <cell id="780"><property name="borderTopColor">#e0e0e0</property><property name="borderTopStyle">solid</property><property name="borderTopWidth">1px</property><property name="paddingTop">3pt</property><label id="781"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><text-property name="text">Maximo Failure Data and Reliability (ISO 14224)  ·  SQL Server, Oracle, Db2  ·  read-only  ·  Created by Mohamed Chihaoui</text-property></label></cell>
                        <cell id="782"><property name="borderTopColor">#e0e0e0</property><property name="borderTopStyle">solid</property><property name="borderTopWidth">1px</property><property name="paddingTop">3pt</property><property name="textAlign">right</property>
                            <grid id="783"><column id="784"/><column id="785"/><column id="786"/><column id="787"/>
                                <row id="788">
                                    <cell id="789"><label id="790"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><property name="textAlign">right</property><text-property name="text">Page</text-property></label></cell>
                                    <cell id="791"><auto-text id="792"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><property name="textAlign">center</property><property name="type">page-number</property></auto-text></cell>
                                    <cell id="793"><label id="794"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><property name="textAlign">center</property><text-property name="text">of</text-property></label></cell>
                                    <cell id="795"><auto-text id="796"><property name="fontSize">7pt</property><property name="color">#6f6f6f</property><property name="type">total-page</property></auto-text></cell>
