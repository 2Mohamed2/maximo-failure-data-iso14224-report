        </table><data id="696"><list-property name="visibility"><structure><property name="format">all</property><expression name="valueExpr" type="javascript"><![CDATA[rows_dsKpi > 0]]></expression></structure></list-property><property name="fontSize">8.5pt</property><property name="color">#6f6f6f</property><property name="paddingTop">10pt</property><property name="paddingBottom">10pt</property><property name="paddingLeft">8pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><list-property name="boundDataColumns"><structure><property name="name">v</property><expression name="expression" type="javascript"><![CDATA[rptEmpty("dsKpi", "The catalogue could not be read.")]]></expression><property name="dataType">string</property></structure></list-property><property name="resultSetColumn">v</property></data><grid id="699"><property name="marginTop">8pt</property><property name="width">10.1in</property><column id="700"/><row id="701"><cell id="702"><property name="backgroundColor">#edf5ff</property><property name="borderLeftColor">#0043ce</property><property name="borderLeftStyle">solid</property><property name="borderLeftWidth">3px</property><property name="paddingTop">6pt</property><property name="paddingBottom">6pt</property><property name="paddingLeft">10pt</property><property name="paddingRight">10pt</property><label id="703"><property name="fontSize">8.5pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Aligning the catalogue</text-property></label><label id="704"><property name="fontSize">8pt</property><property name="color">#525252</property><property name="marginTop">2pt</property><text-property name="text">ISO 14224 gives standard failure mode lists per equipment class (pumps, compressors, valves...); aligning the Maximo problem codes with them makes the data comparable with industry reliability databases.</text-property></label></cell></row></grid><grid id="707"><property name="pageBreakBefore">always</property><property name="pageBreakInside">avoid</property><property name="marginTop">18pt</property><property name="width">10.1in</property><column id="708"/><row id="709"><cell id="710"><label id="705"><property name="fontSize">7.5pt</property><property name="color">#0f62fe</property><property name="fontWeight">bold</property><property name="letterSpacing">0.32pt</property><text-property name="text">APPENDIX</text-property></label><label id="706"><property name="fontSize">14pt</property><property name="color">#161616</property><property name="marginTop">2pt</property><property name="marginBottom">2pt</property><text-property name="text">Method and definitions</text-property></label></cell></row></grid><grid id="761"><property name="width">10.1in</property>
            <column id="762"><property name="width">1.7in</property></column><column id="763"><property name="width">8.4in</property></column><row id="711"><cell id="712"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="713"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">ISO 14224</text-property></label></cell>
                <cell id="714"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="715"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">ISO 14224 (Petroleum, petrochemical and natural gas industries - Collection and exchange of reliability and maintenance data for equipment) defines the data to record for each failure and maintenance event, and an equipment taxonomy. It is the reference for reliability data in oil, gas and petrochemicals and is used well beyond them. The mapping in section 1 is to the closest Maximo field.</text-property></label></cell></row><row id="716"><cell id="717"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="718"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Failure</text-property></label></cell>
                <cell id="719"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="720"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">A corrective or emergency work order (Corrective_Types, Emergency_Types), not generated by a PM, of class WORKORDER, in a completed or closed status (through status synonyms), with an actual finish in the period. Site limits the report.</text-property></label></cell></row><row id="721"><cell id="722"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="723"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Fully coded</text-property></label></cell>
                <cell id="724"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="725"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">The failure has an asset, a failure class, a problem (failure mode), a cause and a remedy (maintenance activity).</text-property></label></cell></row><row id="726"><cell id="727"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="728"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Repair time</text-property></label></cell>
                <cell id="729"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="730"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Actual start to actual finish of the work order, when both are set and the repair took 30 days or less.</text-property></label></cell></row><row id="731"><cell id="732"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="733"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Downtime</text-property></label></cell>
                <cell id="734"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="735"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Downtime hours on asset status changes (ASSETSTATUS) that carry the work order number.</text-property></label></cell></row><row id="736"><cell id="737"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="738"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">MTBF</text-property></label></cell>
                <cell id="739"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="740"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Operating assets of the class x days in the period, divided by the class's failures.</text-property></label></cell></row><row id="741"><cell id="742"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="743"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Catalogue</text-property></label></cell>
                <cell id="744"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="745"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Failure classes: top-level entries of the failure hierarchy (FAILURELIST with no parent). This Maximo: classes, problems, causes and remedies are counted from FAILURELIST.</text-property></label></cell></row><row id="746"><cell id="747"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="748"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Period</text-property></label></cell>
                <cell id="749"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="750"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">By default the 12 complete months before the run date; a database with no recent work moves back to its last month with regular activity, and the header says so. Months and End_Month (YYYY-MM) set it yourself.</text-property></label></cell></row><row id="751"><cell id="752"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="753"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">What is read</text-property></label></cell>
                <cell id="754"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="755"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">WORKORDER, FAILUREREPORT, FAILURECODE, FAILURELIST, ASSET, ASSETSTATUS, CLASSSTRUCTURE, SYNONYMDOMAIN, MAXVARS. Every query is a SELECT; nothing is created or changed. Runs with the Maximo database login on SQL Server, Oracle and Db2.</text-property></label></cell></row><row id="756"><cell id="757"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="758"><property name="fontSize">8pt</property><property name="fontWeight">bold</property><property name="color">#161616</property><text-property name="text">Author</text-property></label></cell>
                <cell id="759"><property name="paddingTop">3pt</property><property name="paddingBottom">3pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><label id="760"><property name="fontSize">8pt</property><property name="color">#525252</property><text-property name="text">Created by Mohamed Chihaoui.</text-property></label></cell></row></grid>
    </body>
</report>
