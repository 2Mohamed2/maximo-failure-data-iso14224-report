        </table><data id="564"><list-property name="visibility"><structure><property name="format">all</property><expression name="valueExpr" type="javascript"><![CDATA[rows_dsRem > 0]]></expression></structure></list-property><property name="fontSize">8.5pt</property><property name="color">#6f6f6f</property><property name="paddingTop">10pt</property><property name="paddingBottom">10pt</property><property name="paddingLeft">8pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><list-property name="boundDataColumns"><structure><property name="name">v</property><expression name="expression" type="javascript"><![CDATA[rptEmpty("dsRem", "No failures in the period.")]]></expression><property name="dataType">string</property></structure></list-property><property name="resultSetColumn">v</property></data><grid id="570"><property name="pageBreakBefore">always</property><property name="pageBreakInside">avoid</property><property name="marginTop">18pt</property><property name="width">10.1in</property><column id="571"/><row id="572"><cell id="573"><label id="567"><property name="fontSize">7.5pt</property><property name="color">#0f62fe</property><property name="fontWeight">bold</property><property name="letterSpacing">0.32pt</property><text-property name="text">3  ·  RELIABILITY</text-property></label><label id="568"><property name="fontSize">14pt</property><property name="color">#161616</property><property name="marginTop">2pt</property><property name="marginBottom">2pt</property><text-property name="text">Reliability by equipment class</text-property></label><label id="569"><property name="fontSize">8.5pt</property><property name="color">#525252</property><property name="marginBottom">8pt</property><text-property name="text">MTBF for a class is the operating time of all its operating assets in the period divided by its failures; MTTR is the average actual repair time (repairs over 30 days left out). Failures on unclassified assets are grouped together: classify them to compare like with like.</text-property></label></cell></row></grid>
        <table id="621">
            <property name="width">10.10in</property>
            <property name="dataSet">dsEquip</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">cls</property>
                    <expression name="expression" type="javascript">dataSetRow["cls"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">n_ops</property>
                    <expression name="expression" type="javascript">dataSetRow["n_ops"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">fails</property>
                    <expression name="expression" type="javascript">dataSetRow["fails"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">failed</property>
                    <expression name="expression" type="javascript">dataSetRow["failed"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">rep_hrs</property>
                    <expression name="expression" type="javascript">dataSetRow["rep_hrs"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">rep_n</property>
                    <expression name="expression" type="javascript">dataSetRow["rep_n"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">cost</property>
                    <expression name="expression" type="javascript">dataSetRow["cost"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">n_full</property>
                    <expression name="expression" type="javascript">dataSetRow["n_full"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">mtbf</property>
                    <expression name="expression" type="javascript"><![CDATA[row["fails"] > 0 && row["n_ops"] > 0 ? Formatter.format(row["n_ops"] * rptP().days / row["fails"], "#,##0.0") : ""]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">mttr</property>
                    <expression name="expression" type="javascript"><![CDATA[row["rep_n"] > 0 ? Formatter.format(row["rep_hrs"] / row["rep_n"], "#,##0.0") : ""]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">fc</property>
                    <expression name="expression" type="javascript"><![CDATA[pctText(row["n_full"], row["fails"])]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">fa</property>
                    <expression name="expression" type="javascript"><![CDATA[pctText(row["failed"], row["n_ops"])]]></expression>
                    <property name="dataType">string</property></structure>
            </list-property>
            <property name="pageBreakInterval">0</property>
            <column id="592"><property name="width">2.2in</property></column><column id="593"><property name="width">1.0in</property></column><column id="594"><property name="width">0.9in</property></column><column id="595"><property name="width">1.0in</property></column><column id="596"><property name="width">0.9in</property></column><column id="597"><property name="width">1.0in</property></column><column id="598"><property name="width">0.9in</property></column><column id="599"><property name="width">1.2in</property></column><column id="600"><property name="width">1.0in</property></column>
